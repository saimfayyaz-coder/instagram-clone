{
  "name": "instagram",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:dev": "react-native run-android --mode=devDebug --appIdSuffix=dev",
    "android:stage": "react-native run-android --mode=stageDebug --appIdSuffix=stage",
    "android:prod": "react-native run-android --mode=prodDebug",
    "build:android:dev": "cd android && gradlew assembleDevRelease",
    "build:android:stage": "cd android && gradlew assembleStageRelease",
    "build:android:prod": "cd android && gradlew assembleProdRelease",
    "bundle:android:prod": "cd android && gradlew bundleProdRelease",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
