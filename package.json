    "@reduxjs/toolkit": "^2.12.0",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "react-native": "0.87.1",
    "react-native-bootsplash": "^7.3.3",
    "react-native-config": "^1.7.2",
    "react-native-gesture-handler": "^3.3.0",
